library(arfima)
library(dplyr)
library(tseries)
library(forecast)
library(purrr)
library(tidyverse)
stock_data["log_return"] <- c(0,diff(log(stock_data$Close)))
stock_data <- stock_data %>% mutate(index =case_when(log_return > 0 ~ 1, TRUE ~ -1))
stock_data["log_return"] <- abs(stock_data["log_return"])
threshold = unname(threshold_median[length(threshold_median)-5])
# threshold = median(stock$volume)
stock_data <- stock_data %>% mutate(actions = case_when(
index == 1 & Volume > threshold ~ 1,
index == -1 & Volume > threshold ~ 2,
index == 1 & Volume < threshold ~ 3,
index == -1 & Volume < threshold ~ 4
))
stock_data["log_return"] <- stock_data["log_return"] + 1 # parallel shift
stock_data$log_return[1] <- 0
acf(stock_data$log_return) # to assure that the process formed by absolute log-returns is long-memory
fit <- arfima::arfima(stock_data$log_return, order=c(3,0,0), lmodel = "d", dmean = TRUE)
print(fit)
p <- 3
d <- 0.3
h <- length(stock_data$log_return)
j <- 1:(h-1)
psi <- numeric(h)
psi[1] <- 1
psi[2:h] <- cumprod((j-1-d)/j)
x_diff <- rep(NA, length(stock_data$log_return))
x_diff[1] <- 0
for(i in 2:h){
x_diff[i] <- sum(rev(stock_data$log_return[1:i]) * psi[1:i])
}
stock_data["log_diff"] <- x_diff
ar_subset <- vector("list",4)
for (i in 1:p){
stock_data <- rbind(rep(0,p),stock_data)
}
for (k in 1:4){
idx = which(stock_data$actions == k)
ar_subset[[k]] <- sapply(idx, function(i) {
stock_data$log_diff[(i - p):i]
})
}
# these lines of code print out the coefficients and noise standard deviations for each arm
err_vec <- c(0,0,0,0)
size_vec <- c(0,0,0,0)
for (k in 1:4){
mat <- ar_subset[[k]]
if (p == 2){
subset_df <- data.frame(
y_tm2 = mat[1,],
y_tm1 = mat[2,],
y_t   = mat[3,]
)
ar_fit <- lm(y_t ~ y_tm1 + y_tm2, data = subset_df)
print(summary(ar_fit))
err_vec[k] <- summary(ar_fit)$sigma^2
size_vec[k] <- nrow(subset_df)
}
else if (p == 4){
subset_df <- data.frame(
y_tm4 = mat[1,],
y_tm3 = mat[2,],
y_tm2 = mat[3,],
y_tm1 = mat[4,],
y_t = mat[5,]
)
ar_fit <- lm(y_t ~ y_tm1 + y_tm2 + y_tm3 + y_tm4, data = subset_df)
print(summary(ar_fit))
err_vec[k] <- summary(ar_fit)$sigma^2
size_vec[k] <- nrow(subset_df)
}
else if (p==3){
subset_df <- data.frame(
y_tm3 = mat[1,],
y_tm2 = mat[2,],
y_tm1 = mat[3,],
y_t   = mat[4,]
)
ar_fit <- lm(y_t ~ y_tm1 + y_tm2 + y_tm3, data = subset_df)
print(summary(ar_fit))
err_vec[k] <- summary(ar_fit)$sigma^2
size_vec[k] <- nrow(subset_df)
}
else{
subset_df <- data.frame(
y_tm1 = mat[1,],
y_t   = mat[2,]
)
ar_fit <- lm(y_t ~ y_tm1, data = subset_df)
print(summary(ar_fit))
err_vec[k] <- summary(ar_fit)$sigma^2
size_vec[k] <- nrow(subset_df)
}
}
